# Copier en .env — valeurs réelles dans Railway (projet snack-manager)
# En production Railway, référencer les services internes :
#   ${{MongoDB.MONGO_URL}} · ${{Postgres.DATABASE_URL}} · ${{Redis.REDIS_URL}}

# ── Bases de données ──
MONGO_URL=mongodb://user:password@host:port/snackmanager?authSource=admin
DATABASE_URL=postgresql://user:password@host:port/railway
REDIS_URL=redis://default:password@host:port

# ── API ──
JWT_SECRET=change-me
PORT=3001

# ── Amorçage (pnpm --filter @sm/db seed) ──
# Facultatifs : sans eux, le seed TIRE un mot de passe aléatoire et l'imprime
# une fois. Aucun mot de passe n'est écrit dans le code — pour en changer un
# ensuite : pnpm --filter @sm/db exec tsx src/set-password.ts <email>
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=

# ── Captures d'écran de la vitrine (scripts/capture-shots.mjs) ──
CAPTURE_OWNER_PASSWORD=

# ── Web (Next.js) ──
# Consommées AU BUILD : une valeur absente en production fait fuiter
# « localhost » dans les balises Open Graph et le JSON-LD, donc dans
# l'indexation Google et les aperçus de partage.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Surfaces terrain (Expo) — inlinées au bundle à l'export ──
EXPO_PUBLIC_API_URL=http://localhost:3001

# ── Optionnel ──
# Paiement en ligne : sans ces clés, le paiement au comptoir reste disponible.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Domaines clients : railway (défaut) ou cloudflare au-delà d'une centaine d'écrans/clients.
# DOMAIN_PROVIDER=railway
# RAILWAY_TOKEN=
