# Copier en .env pour l'API et les outils racine — valeurs réelles dans Railway
# (projet snack-manager). Expo charge ses fichiers depuis chaque application :
# voir apps/kds/.env.example pour une commande Expo KDS lancee directement.
# En production Railway, référencer les services internes :
#   ${{MongoDB.MONGO_URL}} · ${{Postgres.DATABASE_URL}} · ${{Redis.REDIS_URL}}

# ── Bases de données ──
MONGO_URL=mongodb://user:password@host:port/snackmanager?authSource=admin
DATABASE_URL=postgresql://user:password@host:port/railway
# Budget TOTAL partagé par Supply et Fidélité dans le processus API.
SM_PG_POOL_MAX=10
REDIS_URL=redis://default:password@host:port

# ── Fidélité : données client chiffrées et idempotence ──
# Quatre secrets indépendants, 32 octets chacun encodés en base64. Les laisser
# vides tant que le module n'est pas activé ; ne jamais les exposer au web/POS.
LOYALTY_PROFILE_ENCRYPTION_KEY_V1=
LOYALTY_PROFILE_KEY_VERSION=1
LOYALTY_PHONE_LOOKUP_KEY=
LOYALTY_OPERATION_FINGERPRINT_KEY=
# Rend un replay d'adhésion strictement stable sans stocker le QR en clair.
# Pilote : conserver cette clé durant toute la vie des cartes V1 ; une rotation
# exige une réémission contrôlée des QR (un changement sauvage échoue fermé).
LOYALTY_QR_DERIVATION_KEY=

# ── API ──
NODE_ENV=development
JWT_SECRET=change-me
PORT=3001
# OBLIGATOIRE — l'API refuse de démarrer sans elle, et c'est voulu. C'est la
# racine des adresses que nous servons (« classfood.snackmanager.fr ») ET la
# cible CNAME dictée aux restaurateurs : un repli silencieux survivrait à une
# variable oubliée en production, et le client pointerait son DNS à côté.
# Doit désigner le MÊME domaine que NEXT_PUBLIC_PRIMARY_DOMAIN côté web.
PUBLIC_ROOT_DOMAIN=snackmanager.fr

# ── Protection des commandes publiques (Cloudflare Turnstile + Redis) ──
# Ces clés de test Cloudflare ne produisent qu'un jeton fictif. L'API les
# accepte UNIQUEMENT avec TURNSTILE_TEST_MODE=1 et NODE_ENV=development/test,
# hors Railway. En production, créer un widget « Managed », remplacer les deux clés
# et déclarer les hôtes réels du tunnel de commande (séparés par des virgules).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost
TURNSTILE_TEST_MODE=1
# Quotas atomiques partagés par toutes les répliques API. Le refus est fermé :
# si Redis ou Turnstile ne répond pas, aucune commande n'entre en cuisine.
PUBLIC_ORDER_TENANT_BURST_LIMIT=12
PUBLIC_ORDER_TENANT_HOURLY_LIMIT=60
PUBLIC_ORDER_GLOBAL_MINUTE_LIMIT=300

# ── Amorçage (pnpm --filter @sm/db seed) ──
# Facultatifs : sans eux, le seed TIRE un mot de passe aléatoire et l'imprime
# une fois. Aucun mot de passe n'est écrit dans le code — pour en changer un
# ensuite : pnpm --filter @sm/db exec tsx src/set-password.ts <email>
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=

# ── Captures d'écran de la vitrine (scripts/capture-shots.mjs) ──
CAPTURE_OWNER_PASSWORD=

# ── Formulaire de contact → CRM (serveur à serveur) ──
# Même valeur aléatoire longue sur les services Railway `web` et `api`.
# Le navigateur ne la reçoit jamais ; elle autorise uniquement POST /public/leads.
SM_CONTACT_INGEST_TOKEN=replace-with-a-long-random-token
# Même clé aléatoire de 32 octets encodée en base64 sur les services `web` et
# `api`. Requise au démarrage de l'API en production, elle signe uniquement
# l'identité réseau pseudonymisée du relais fidélité ; elle n'est jamais
# exposée au navigateur. Une valeur différente entre Web et API fait échouer
# les lectures de carte en 503 (jamais en quota partagé). Génération :
#   openssl rand -base64 32
SM_PUBLIC_RELAY_SIGNING_KEY=
# Origine INTERNE appelée par le serveur Next, distincte de l'URL publique
# inlinée dans le navigateur. `LEADS_ENDPOINT` ne se change que si la route API
# est volontairement déplacée.
API_URL=http://localhost:3001
LEADS_ENDPOINT=/public/leads

# ── Web (Next.js) ──
# Consommées AU BUILD : une valeur absente en production fait fuiter
# « localhost » dans les balises Open Graph et le JSON-LD, donc dans
# l'indexation Google et les aperçus de partage.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Sert aussi de destination au bandeau « Retour au site » des démonstrations
# `?demo=1` (back-office, commande en ligne). Absente, elles retombent sur `/`,
# la racine de l'origine courante — jamais sur une adresse venue de l'URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origine de l'écran de salle, imprimée dans « Écrans TV » et RECOPIÉE SUR UNE
# CLÉ HDMI : le gérant la saisit une fois, sur un escabeau, puis plus jamais.
# Elle doit donc rester CONSTANTE dans le temps, même si le back-office
# déménage sur une autre origine — l'appairage vit dans le localStorage DE
# L'ORIGINE, et en changer révoque de fait tous les écrans déjà installés.
# Absente, la page retombe sur l'origine courante (développement, aperçus).
NEXT_PUBLIC_BOARD_ORIGIN=http://localhost:3000
# Clé publique de test Turnstile. Remplacer au build de production par la clé
# du widget associé aux domaines publics de commande.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Surfaces terrain (Expo) — inlinées au bundle à l'export ──
EXPO_PUBLIC_API_URL=http://localhost:3001
# Localhost est refuse par defaut, meme si l'URL ci-dessus est presente. Ce
# drapeau ne doit exister que dans le .env de developpement ; production et
# staging utilisent leurs origines HTTPS explicitement autorisees par le code.
EXPO_PUBLIC_ALLOW_LOCAL_API=1
# Destination du bandeau « Retour au site » des démonstrations `?demo=1`.
# Elle ne vient JAMAIS de l'URL : accepter un `?retour=…` publierait une
# redirection ouverte depuis nos propres domaines. Absente, la caisse et
# l'écran cuisine retombent sur l'adresse de production du site.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# ── Optionnel ──
# Paiement en ligne : sans ces clés, le paiement au comptoir reste disponible.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# ── Encaissement des restaurants (Stripe Connect, charges directes) ──
# Chaque restaurant raccorde SON compte : ses commandes en ligne sont
# encaissées chez lui, jamais sur le compte de la plateforme (encaisser pour
# autrui est un service de paiement réservé aux établissements agréés).
#
# Les événements des comptes connectés arrivent sur un SECOND point d'entrée,
# signé avec un secret DIFFÉRENT. Sans lui, un client paie, le restaurant
# encaisse, et la commande reste « en attente » : la cuisine ne la voit jamais.
#   Tableau de bord → Developers → Webhooks → **Connected accounts** →
#   https://<api>/public/stripe/webhook/connect
#   Événements : account.updated, payment_intent.succeeded, payment_intent.payment_failed
#   En local : stripe listen --forward-connect-to localhost:3001/public/stripe/webhook/connect
# STRIPE_CONNECT_WEBHOOK_SECRET=
#
# Origine publique du back-office — Stripe y renvoie le restaurateur après son
# inscription. Codée en dur, elle renverrait un restaurateur de production sur
# l'environnement de test, avec un compte Stripe bien réel au bout.
# WEB_PUBLIC_URL=https://app.snackmanager.fr
# Domaines clients : railway (défaut) ou cloudflare au-delà d'une centaine d'écrans/clients.
# DOMAIN_PROVIDER=railway
# RAILWAY_TOKEN=

# ── Amorçage de démonstration ──
# `on` remplit le pipeline CRM et l'historique de facturation quand ils sont
# vides. Absent = rien ne s'écrit. Ne JAMAIS poser en production.
SM_DEMO_SEED=
