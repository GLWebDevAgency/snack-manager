# Copier en .env — valeurs réelles dans Railway (projet snack-manager)
# En production Railway, référencer les services internes :
#   ${{MongoDB.MONGO_URL}} · ${{Postgres.DATABASE_URL}} · ${{Redis.REDIS_URL}}

# ── Bases de données ──
MONGO_URL=mongodb://user:password@host:port/snackmanager?authSource=admin
DATABASE_URL=postgresql://user:password@host:port/railway
REDIS_URL=redis://default:password@host:port

# ── API ──
JWT_SECRET=change-me
PORT=3001
# OBLIGATOIRE — l'API refuse de démarrer sans elle, et c'est voulu. C'est la
# racine des adresses que nous servons (« classfood.snackmanager.fr ») ET la
# cible CNAME dictée aux restaurateurs : un repli silencieux survivrait à une
# variable oubliée en production, et le client pointerait son DNS à côté.
# Doit désigner le MÊME domaine que NEXT_PUBLIC_PRIMARY_DOMAIN côté web.
PUBLIC_ROOT_DOMAIN=snackmanager.fr

# ── Amorçage (pnpm --filter @sm/db seed) ──
# Facultatifs : sans eux, le seed TIRE un mot de passe aléatoire et l'imprime
# une fois. Aucun mot de passe n'est écrit dans le code — pour en changer un
# ensuite : pnpm --filter @sm/db exec tsx src/set-password.ts <email>
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=

# ── Captures d'écran de la vitrine (scripts/capture-shots.mjs) ──
CAPTURE_OWNER_PASSWORD=

# ── Web (Next.js) ──
# Consommées AU BUILD : une valeur absente en production fait fuiter
# « localhost » dans les balises Open Graph et le JSON-LD, donc dans
# l'indexation Google et les aperçus de partage.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Sert aussi de destination au bandeau « Retour au site » des démonstrations
# `?demo=1` (back-office, commande en ligne). Absente, elles retombent sur `/`,
# la racine de l'origine courante — jamais sur une adresse venue de l'URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origine de l'écran de salle, imprimée dans « Écrans TV » et RECOPIÉE SUR UNE
# CLÉ HDMI : le gérant la saisit une fois, sur un escabeau, puis plus jamais.
# Elle doit donc rester CONSTANTE dans le temps, même si le back-office
# déménage sur une autre origine — l'appairage vit dans le localStorage DE
# L'ORIGINE, et en changer révoque de fait tous les écrans déjà installés.
# Absente, la page retombe sur l'origine courante (développement, aperçus).
NEXT_PUBLIC_BOARD_ORIGIN=http://localhost:3000

# ── Surfaces terrain (Expo) — inlinées au bundle à l'export ──
EXPO_PUBLIC_API_URL=http://localhost:3001
# Destination du bandeau « Retour au site » des démonstrations `?demo=1`.
# Elle ne vient JAMAIS de l'URL : accepter un `?retour=…` publierait une
# redirection ouverte depuis nos propres domaines. Absente, la caisse et
# l'écran cuisine retombent sur l'adresse de production du site.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# ── Optionnel ──
# Paiement en ligne : sans ces clés, le paiement au comptoir reste disponible.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Domaines clients : railway (défaut) ou cloudflare au-delà d'une centaine d'écrans/clients.
# DOMAIN_PROVIDER=railway
# RAILWAY_TOKEN=

# ── Amorçage de démonstration ──
# `on` remplit le pipeline CRM et l'historique de facturation quand ils sont
# vides. Absent = rien ne s'écrit. Ne JAMAIS poser en production.
SM_DEMO_SEED=
