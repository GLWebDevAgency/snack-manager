{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // `migrate.ts` EST compilé : il tourne en pré-déploiement sur Railway, dans
  // un conteneur qui n'a ni `tsx` ni les dépendances de développement. Les
  // migrations doivent s'appliquer AVANT que la nouvelle version ne serve du
  // trafic, sinon le code parle à un schéma qui n'existe pas encore.
  // `seed.ts`, lui, reste dehors : une amorce de démonstration n'a rien à
  // faire dans une image de production.
  "exclude": ["src/seed.ts", "src/**/*.test.ts"]
}
