# Expo/React Native exigent un node_modules aplati : leur résolution de
# modules natifs ne suit pas l'isolation stricte de pnpm.
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Refuser immédiatement une installation avec un runtime hors de la borne
# `engines.node` du package racine, au lieu de laisser un simple avertissement.
engine-strict=true
