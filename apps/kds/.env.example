# Expo charge les fichiers .env depuis la racine de CETTE application.
# `pnpm --filter @sm/kds dev` fournit deja ces valeurs locales par defaut ; ce
# fichier sert aux commandes Expo directes et aux environnements personnalises.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_ALLOW_LOCAL_API=1
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# Ne jamais activer EXPO_PUBLIC_ALLOW_LOCAL_API dans un build staging ou
# production. Les origines HTTPS distantes admises sont controlees par
# src/api-origin.ts ; une autre valeur bloque l'application avant tout appel.
