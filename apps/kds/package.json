{
  "name": "@sm/kds",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@sm/design-icons": "workspace:*",
    "@sm/design-tokens": "workspace:*",
    "expo": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "expo-keep-awake": "~15.0.0",
    "expo-screen-orientation": "~9.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sm/client-core": "workspace:*",
    "@sm/contracts": "workspace:*",
    "@sm/ui-native": "workspace:*",
    "expo-font": "~57.0.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  },
  "scripts": {
    "start": "node server.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://localhost:3001} EXPO_PUBLIC_ALLOW_LOCAL_API=${EXPO_PUBLIC_ALLOW_LOCAL_API:-1} EXPO_PUBLIC_SITE_URL=${EXPO_PUBLIC_SITE_URL:-http://localhost:3000} expo start --web",
    "dev": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://localhost:3001} EXPO_PUBLIC_ALLOW_LOCAL_API=${EXPO_PUBLIC_ALLOW_LOCAL_API:-1} EXPO_PUBLIC_SITE_URL=${EXPO_PUBLIC_SITE_URL:-http://localhost:3000} expo start --web --port 8083",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://localhost:3001} EXPO_PUBLIC_ALLOW_LOCAL_API=${EXPO_PUBLIC_ALLOW_LOCAL_API:-1} vitest run",
    "lint": "echo ok",
    "build": "node ../../scripts/verifier-build-terrain.mjs && expo export --platform web --output-dir dist --clear"
  },
  "private": true
}
